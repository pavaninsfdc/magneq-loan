#%RAML 1.0
title: magneq-loan-latest-api
version: 1.0.0

securitySchemes:
  auth:
    type: OAuth 2.0

traits:
  requestHeaders: !include /resuableProperties/Traits/requestHeaders.raml
  queryParameters: !include /resuableProperties/Traits/queryParams.raml

types:
  inputSchema: !include /resuableProperties/Types/inputSchema.raml
  outputSchema: !include /resuableProperties/Types/successResp.raml
  clientErrors: !include /resuableProperties/Types/ClientErrors.raml
  serverErrors: !include /resuableProperties/Types/ServerErrors.raml
  
resourceTypes:
  loan_id_resource: !include /resuableProperties/resourceTypes/resourceType.raml
  

/loans:
  securedBy:
    - auth
  is:
    - requestHeaders
  description: To create Loan Accounts for customers
  post:
    body:
      application/json:
        type: inputSchema
    responses:
      201:
        body:
          application/json:
            type: outputSchema
      400:
        body:
          application/json:
            type: clientErrors
      500:
        body:
          application/json:
            type: serverErrors

  /{loan_type}:
    uriParameters:
      loan_type:
        type: string
        enum: ["PERSONAL", "GOLD", "VEHICLE", "HOME"]
    get:
      description: To fetch/retrieve the loan details belonging to a specific loan type of a customer
      is:
        - queryParameters
      
      responses:
        200:
          body:
            application/json:
              example: !include /resuableProperties/Types/example.raml
               
    /{loan_id}:
      uriParameters:
        loan_id:
          type: string
      type: loan_id_resource
      